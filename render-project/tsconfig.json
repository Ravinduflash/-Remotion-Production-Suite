{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/lib/remocn-ui": [
        "src/remotion/community/remocn-ui"
      ],
      "@/lib/remocn-icons": [
        "src/remotion/community/remocn-icons"
      ],
      "@/lib/remocn/*": [
        "src/remotion/community/*"
      ],
      "@/components/remocn/*": [
        "src/remotion/community/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}
